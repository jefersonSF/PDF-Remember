<Window x:Class="PDFViewLastReadedPage.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PDF Remember"
        Width="460"
        Height="490"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8">

    <Border Margin="12"
            Background="White"
            CornerRadius="12"
            Padding="25">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Application header -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center">

                <!-- Replace with your application icon -->
                <Border Width="64"
                        Height="64"
                        Background="#F0F1F3"
                        CornerRadius="24"
                        HorizontalAlignment="Center">

                    <Image Source="pack://application:,,,/Resources/pdf-read.ico"
                           Width="55"
                           Height="48"
                           Stretch="Fill"
                           />
                </Border>

                <TextBlock Text="PDF Remember"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#202124"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <TextBlock Text="Version 1.0.0"
                           FontSize="12"
                           Foreground="#777777"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <!-- Description -->
            <StackPanel Grid.Row="1"
                        Margin="0,24,0,20">

                <TextBlock Text="A PDF reader that remembers where you left off."
                           FontSize="14"
                           Foreground="#444444"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

            </StackPanel>

            <!-- Technologies -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center">

                <TextBlock Text="Developed with"
                           FontSize="12"
                           Foreground="#777777"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Border Background="#E8F1FC"
                            CornerRadius="5"
                            Padding="12,6"
                            Margin="4,0">

                        <TextBlock Text="C#"
                                   Foreground="#245A9B"
                                   FontWeight="SemiBold"/>

                    </Border>

                    <Border Background="#E8F1FC"
                            CornerRadius="5"
                            Padding="12,6"
                            Margin="4,0">

                        <TextBlock Text="WPF"
                                   Foreground="#245A9B"
                                   FontWeight="SemiBold"/>

                    </Border>

                    <Border Background="#E8F1FC"
                            CornerRadius="5"
                            Padding="12,6"
                            Margin="4,0">

                        <TextBlock Text=".NET 10"
                                   Foreground="#245A9B"
                                   FontWeight="SemiBold"/>

                    </Border>

                </StackPanel>

            </StackPanel>

            <!-- Links -->
            <StackPanel Grid.Row="3"
                        VerticalAlignment="Center"
                        Margin="10,15">

                <TextBlock Text="Resources"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#777777"
                           Margin="0,0,0,12"/>

                <TextBlock Margin="0,6">
                    <Hyperlink NavigateUri="https://github.com/jefersonSF/PDF-Remember"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        GitHub Repository
                    </Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,6">
                    <Hyperlink NavigateUri="https://github.com/jefersonSF/PDF-Remember/issues"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        Report an Issue
                    </Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,6">
                    <Hyperlink NavigateUri="https://github.com/jefersonSF/PDF-Remember"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        Third-party Notices
                    </Hyperlink>
                </TextBlock>

            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="4"
                        HorizontalAlignment="Center">

                <Separator Background="#EEEEEE"
                           Margin="0,0,0,15"/>

                <TextBlock Text="© 2026 · PDF Remember"
                           FontSize="11"
                           Foreground="#999999"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>
    